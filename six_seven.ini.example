; ============================================================
; Six_Seven — ОБРАЗЕЦ настроек (six_seven.ini.example)
;
; ВАЖНО: программа читает только six_seven.ini (рядом с exe),
; а НЕ этот файл. При первом запуске six_seven.ini создаётся
; автоматически (копия этого образца). Дальше правьте six_seven.ini.
;
; config.h — размер окна, спрайты, фразы; нужна пересборка (build-mingw.bat).
; six_seven.ini — задержки «скуки», прогулка, позиция окна, mute, дыхание.
;
; После изменений ini перезапустите программу.
; Строки с «;» — комментарии.
; ============================================================

[idle]
; Анимация дыхания в покое (кадры в assets/sprites/idle/).
; 1 = включено, 0 = выключено (статичная картинка).
breath=1

[def]
; «Скука»: если пользователь долго не трогает персонажа,
; он сам что-то делает — моргает, говорит, уходит прогуляться.
; Задержка в секундах; реальное время случайно между min и max.
; Сбрасывается при перетаскивании, клике и речи.
delay_min_sec=90
delay_max_sec=180
; Сколько секунд идти после фразы «пойду прогуляюсь» (ходьба + отскок от краёв).
wander_walk_sec=12

[window]
; Позиция окна на экране в пикселях.
; -1 = случайное место при каждом запуске.
; При выходе программа сама сохраняет сюда текущую позицию.
x=-1
y=-1

[audio]
; Звук и озвучка (SAPI).
; 1 = без звука, 0 = звук включён.
mute=0

[boot]
; Логотип при ВКЛЮЧЕНИИ ПК: PNG в assets/sprites/loading/.
; Установка: трей Six_Seven → «Установить логотип загрузки ПК» (+ HackBGRT в папке HackBGRT/).
; enabled — старый overlay при входе в Windows (обычно не нужен):
enabled=0
; Запускать Six_Seven после загрузки Windows:
autostart=1
; min_sec — только для enabled=1 (overlay при входе в Windows):
min_sec=4

[tts]
; Подстрока имени голоса SAPI (см. tts_voices.txt после запуска). Пусто = любой русский.
; voice_hint=Microsoft Irina Desktop

[bubble]
; Максимум строк в облачке речи; при переполнении текст листается вверх.
max_lines=6

[ai]
; Настроение и «личность» (0–100). Программа обновляет сама по времени суток и праздникам.
mood=65
; Злость (0–100) — накапливается, когда над 67 издеваются.
anger=0
; Фрагменты ключа Vault (0–5): выигрывай мини-игры.
vault_fragments=0
; День (с 1970-01-01), когда был получен последний фрагмент. Обновляется сама.
vault_fragment_day=0
; API-ключ для чата (меню «Спец. функции» → «Спросить 67»).
; deepseek_key=sk-...
